manifest {
    name            = 'igf2bp2-pdac-sc-spatial-reassessment'
    description     = 'Spatially aware reassessment of an IGF2BP2-high state in PDAC (GSE111672)'
    nextflowVersion = '>=25.04.0'
}

params {
    outdir     = "/scratch/${System.getenv('USER')}/pdac_spatial/results"
    smoke_gpu  = false
}

profiles {
    explorer {
        conda.enabled = true
        workDir       = "/scratch/${System.getenv('USER')}/pdac_spatial/work"
        executor.queueSize = 10

        env {
            PYTHONNOUSERSITE = '1'
        }

        process {
            executor = 'slurm'
            queue    = 'short'
            cpus     = 2
            memory   = '8 GB'
            time     = '1h'
            conda    = "/scratch/${System.getenv('USER')}/envs/pdac-spatial"

            withLabel: gpu {
                queue          = 'gpu'
                clusterOptions = '--gres=gpu:1'
                time           = '2h'
                conda          = "/scratch/${System.getenv('USER')}/envs/cell2loc_cu121"
            }
        }
    }
}